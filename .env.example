LLM_DEFAULT_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-chat
LLM_API_KEY=your_deepseek_api_key_here
LLM_API_BASE=https://api.deepseek.com

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://root:123456@127.0.0.1:5433/ecommerce_aftersales
ASYNC_DATABASE_URL=postgresql+asyncpg://root:123456@127.0.0.1:5433/ecommerce_aftersales
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=ecommerce_aftersales
# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:your_redis_password_here@127.0.0.1:6380/0
MEMORY_TYPE=redis

# 意图置信度阈值策略（第二轮方案 §3.1；留空即用代码默认值 0.8 / 0.5 / true）
# 阈值来自 eval/datasets/intent_slots.jsonl 全量标注集标定，改动请重跑
# python eval/run_intent_eval.py --mode llm --db stub --confidence-report eval/reports/confidence-llm.md
INTENT_CONFIDENCE_ENABLED=true
INTENT_CONFIDENCE_HIGH=0.8
INTENT_CONFIDENCE_LOW=0.5
